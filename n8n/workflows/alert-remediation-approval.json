    {
      "parameters": {
        "jsCode": "const pr = $('Next PR').first().json;\nconst files = $input.all().map(i => i.json).filter(f => f.filename);\nconst list = files.slice(0, 15).map(f => `• \\`${f.filename}\\` (+${f.additions} −${f.deletions})`);\nif (files.length > 15) list.push(`• … and ${files.length - 15} more`);\nconst msg = [\n  `🛠️ **Claude opened PR #${pr.number}:** ${pr.title}`.replace(/@/g, '@​'),\n  pr.url,\n  ...list,\n  pr.session ? `Session: ${pr.session}` : null,\n  '',\n  'Approve = mark ready, add `gate-approved`, squash-merge once every check is green.',\n  'Reject = close the PR and delete the branch. No answer in 24h = left open.',\n].filter(l => l !== null).join('\\n');\nreturn [{ json: { message: msg.slice(0, 1900) } }];\n"
      },
