    {
      "parameters": {
        "jsCode": "// Merge only when the required checks are green on the approved head. The PAT is an\n// admin, and the ruleset's admin bypass would let a merge through on red checks.\nconst REQUIRED = ['kustomize build + kubeconform', 'yamllint', 'gitleaks', 'automerge gate'];\nconst pr = $('Next PR').first().json;\nconst latest = {};\nfor (const r of $input.first().json.check_runs ?? []) {\n  if (!latest[r.name] || r.id > latest[r.name].id) latest[r.name] = r;\n}\n// Loops back through `Wait for checks` (2 min) while anything is still running,\n// up to ~20 min. A red check fails straight away.\nconst TRIES = 10;\nconst failed = [], running = [];\nfor (const name of REQUIRED) {\n  const r = latest[name];\n  if (!r || r.status !== 'completed') running.push(`${name}: ${r?.status ?? 'not started'}`);\n  // The gate's pre-label run failed by design; its re-run on `labeled` may not exist yet.\n  else if (r.conclusion !== 'success' && name === 'automerge gate' && $runIndex < 3) running.push(`${name}: awaiting re-run`);\n  else if (r.conclusion !== 'success') failed.push(`${name}: ${r.conclusion}`);\n}\nfor (const r of Object.values(latest)) {\n  if (REQUIRED.includes(r.name)) continue;\n  if (r.status !== 'completed') running.push(`${r.name}: ${r.status}`);\n  else if (!['success', 'skipped', 'neutral'].includes(r.conclusion)) failed.push(`${r.name}: ${r.conclusion}`);\n}\nconst stop = why => { throw new Error(`PR #${pr.number} approved but not merged, ${why}. Merge by hand once they pass: ${pr.url}`); };\nif (failed.length) stop(`checks failed (${failed.join('; ')})`);\nif (running.length && $runIndex + 1 >= TRIES) stop(`checks still running after ~${TRIES * 2} min (${running.join('; ')})`);\nreturn [{ json: { state: running.length ? 'running' : 'green', number: pr.number, sha: pr.sha } }];\n"
      },
