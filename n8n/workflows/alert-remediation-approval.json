    {
      "parameters": {
        "jsCode": "// One PR per poll: Send-and-Wait parks this execution until you answer, so the\n// `claude-announced` label (added next) is the ledger, not static data, which is\n// only saved when an execution finishes.\nconst prs = $input.all().map(i => i.json).filter(p =>\n  p?.head?.ref?.startsWith('claude/alert-') &&\n  p.head.repo?.full_name === 'calebbutcher/home-ops' &&\n  !(p.labels ?? []).some(l => l.name === 'claude-announced'));\nif (!prs.length) return [];\nconst p = prs.at(-1);   // listed newest first; take the oldest waiting\nconst session = ((p.body ?? '').match(/https:\\/\\/claude\\.ai\\/code\\/[\\w\\/-]+/) ?? [])[0] ?? null;\nreturn [{ json: {\n  number: p.number, title: p.title, url: p.html_url, ref: p.head.ref, sha: p.head.sha,\n  nodeId: p.node_id, draft: p.draft, session,\n} }];\n"
      },
      "id": "bebd739b-b441-5aff-9046-54d1c59165c5",
      "name": "Next PR",
