    {
      "parameters": {
        "jsCode": "// Listing PRs failed (expired PAT, GitHub outage). This runs every 5 min, so post at\n// most once every 6h instead of failing each run into the error workflow.\nconst state = $getWorkflowStaticData('global');\nconst now = Date.now();\nif (now - (state.lastGitHubError ?? 0) < 6 * 36e5) return [];\nstate.lastGitHubError = now;\nconst err = $input.first().json.error;\nreturn [{ json: { content: `⚠️ Alert remediation approval can't list PRs: ${String(err?.message ?? err ?? 'unknown error').slice(0, 300)}. Check the \\`GitHub home-ops\\` token. (Muted for 6h.)`.replace(/@/g, '@\\u200b') } }];\n"
      },
      "id": "6d5a868c-f3b0-50fe-9e33-dfea6ae13846",
